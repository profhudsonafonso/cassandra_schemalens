+#!/usr/bin/env bash
+# Cria o ambiente Python único do repositório em ./.venv (Python 3.12) com as versões fixadas.
+set -euo pipefail
+cd "$(dirname "${BASH_SOURCE[0]}")"
+PYTHON="${PYTHON:-python3}"
+[[ -x .venv/bin/python ]] || "$PYTHON" -m venv .venv
